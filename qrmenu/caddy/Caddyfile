(app) {
	encode zstd gzip

	# Uploaded photos: file names are unique per upload, so cache forever
	handle /media/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# /t/{token} is the URL printed in table QR codes: the api starts a session and redirects
	@api path /api/* /t/*
	handle @api {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:80
	}
}

{$DOMAIN:localhost} {
	import app
}

# Plain http on any other address, e.g. http://192.168.1.10 — for trying the QR codes with a
# phone on the same Wi-Fi before there is a domain (PUBLIC_BASE_URL=http://<computer's IP>)
http:// {
	import app
}
