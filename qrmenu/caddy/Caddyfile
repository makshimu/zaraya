{$DOMAIN:localhost} {
	encode zstd gzip

	# Uploaded photos: file names are unique per upload, so cache forever
	handle /media/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# /t/{token} is the URL printed in table QR codes: the api starts a session and redirects
	@api path /api/* /t/*
	handle @api {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:80
	}
}
