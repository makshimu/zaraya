# Domain Caddy serves; a real domain gets a Let's Encrypt certificate automatically
DOMAIN=localhost
# Origin printed into table QR codes
PUBLIC_BASE_URL=https://localhost

POSTGRES_PASSWORD=change-me
# openssl rand -hex 32
JWT_SECRET=change-me

# true: on the first start fill the empty database with a demo café (menu in 6 languages,
# tables, waiters, 30 days of orders). Or any time: docker compose exec api python -m app.demo --reset
DEMO_DATA=false

# First admin, created on the first start only
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin

# Daily database backup (local time in TZ), dumps older than BACKUP_KEEP_DAYS are deleted
BACKUP_TIME=03:30
BACKUP_KEEP_DAYS=14
TZ=Asia/Ho_Chi_Minh
